# environments / caches (project-local by design)
.venv/
.cache/
bin/*.exe
bin/*.dll
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# campaign working directories and cross-campaign memory: local research state, never committed
campaigns/
library/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.out

# OS / editor
Thumbs.db
.DS_Store
*.swp

# project-local junctions to ../agents and ../skills (recreated by scripts/bootstrap.*)
.claude/agents/
.claude/skills/

# eval workspaces and results (regenerated)
evals/results/

# embedded interpreters / tool downloads that land in the project root (nothing here depends on them)
Python/

# stray literal-variable directories Windows tools sometimes create in the project root
%SystemDrive%/
%USERPROFILE%/
${*}/
