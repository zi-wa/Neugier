{
  "env": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/hooks/enforce_venv.py\"", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/hooks/inject_context.py\"", "timeout": 40 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/hooks/inject_context.py\"", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/hooks/gate_stop.py\"", "timeout": 60 }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe *)",
      "Bash(uv pip install --python .venv/Scripts/python.exe *)",
      "Bash(bin/tectonic.exe *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(curl -s *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
